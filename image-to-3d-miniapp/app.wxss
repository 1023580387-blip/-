/**
 * app.wxss - 全局样式
 * 极简科技风半透明玻璃UI，蓝色科技高亮风格
 */

/* ==================== CSS 变量 / 设计令牌 ==================== */
page {
  --color-primary: #4da6ff;        /* 主蓝色 */
  --color-primary-glow: #4da6ff66; /* 蓝色发光 */
  --color-bg-dark: #0a0a1a;        /* 深色背景 */
  --color-bg-glass: rgba(15, 20, 40, 0.85);  /* 玻璃面板背景 */
  --color-bg-glass-light: rgba(20, 30, 60, 0.6); /* 浅玻璃面板 */
  --color-text: #e8e8f0;           /* 主文字 */
  --color-text-secondary: #8899bb; /* 次要文字 */
  --color-border: rgba(77, 166, 255, 0.2); /* 边框色 */
  --color-success: #4dff91;        /* 成功绿 */
  --color-warning: #ffb84d;        /* 警告橙 */
  --color-error: #ff4d6a;          /* 错误红 */

  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-round: 50%;

  --shadow-glass: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
  --shadow-glow: 0 0 20rpx rgba(77, 166, 255, 0.3);

  /* 基础样式 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg-dark);
  box-sizing: border-box;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ==================== 通用工具类 ==================== */

/* 玻璃面板效果 */
.glass-panel {
  background: var(--color-bg-glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-glass);
}

/* 玻璃按钮 */
.glass-btn {
  background: var(--color-bg-glass-light);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  transition: all 0.3s ease;
}

.glass-btn:active {
  transform: scale(0.96);
  opacity: 0.8;
}

/* 主按钮（蓝色高亮） */
.btn-primary {
  background: linear-gradient(135deg, #4da6ff, #2d7aff);
  border: none;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(77, 166, 255, 0.35);
}

.btn-primary:active {
  box-shadow: 0 4rpx 12rpx rgba(77, 166, 255, 0.2);
}

/* 科技发光边框 */
.glow-border {
  border: 1rpx solid var(--color-primary-glow);
  box-shadow: 0 0 16rpx rgba(77, 166, 255, 0.15), inset 0 0 16rpx rgba(77, 166, 255, 0.05);
}

/* 科技感文字 */
.tech-text {
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 弹性布局 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

/* 文字省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  background: transparent;
}