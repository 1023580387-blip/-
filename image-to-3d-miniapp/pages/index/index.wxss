/**
 * index.wxss - 首页上传页面样式
 * 极简科技风半透明玻璃UI
 */

/* ==================== 页面容器 ==================== */
.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #0a0a1a 0%, #0d1230 40%, #0a0a1a 100%);
  overflow: hidden;
  position: relative;
}

/* ==================== 顶部标题区 ==================== */
.header-section {
  width: 100%;
  padding: 60rpx 40rpx 20rpx;
  display: flex;
  justify-content: center;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #4da6ff, #2d5aff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(77, 166, 255, 0.4);
}

.logo-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.title-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.subtitle-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
}

/* ==================== 中间预览动画区 ==================== */
.preview-area {
  width: 320rpx;
  height: 320rpx;
  margin: 30rpx 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 3D旋转立方体（纯CSS模拟） */
.rotating-cube {
  width: 120rpx;
  height: 120rpx;
  position: relative;
  transform-style: preserve-3d;
  animation: rotate3d 8s linear infinite;
}

.cube-face {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid rgba(77, 166, 255, 0.4);
  background: rgba(77, 166, 255, 0.08);
  backdrop-filter: blur(4px);
}

.front  { transform: translateZ(60rpx); }
.back   { transform: rotateY(180deg) translateZ(60rpx); }
.left   { transform: rotateY(-90deg) translateZ(60rpx); }
.right  { transform: rotateY(90deg) translateZ(60rpx); }
.top    { transform: rotateX(90deg) translateZ(60rpx); }
.bottom { transform: rotateX(-90deg) translateZ(60rpx); }

@keyframes rotate3d {
  from { transform: rotateX(-20deg) rotateY(0deg); }
  to   { transform: rotateX(-20deg) rotateY(360deg); }
}

/* 装饰粒子 */
.particle {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(77, 166, 255, 0.5);
  animation: float 3s ease-in-out infinite;
}

.p1 { top: 20%; left: 10%; animation-delay: 0s; }
.p2 { top: 60%; right: 15%; animation-delay: 0.8s; }
.p3 { bottom: 20%; left: 20%; animation-delay: 1.6s; }
.p4 { top: 30%; right: 25%; animation-delay: 2.4s; }

@keyframes float {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.5; }
  50%      { transform: translateY(-20rpx) scale(1.5); opacity: 0.8; }
}

/* ==================== 上传按钮区 ==================== */
.action-section {
  width: 100%;
  padding: 0 40rpx;
  display: flex;
  gap: 24rpx;
}

.upload-btn {
  flex: 1;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: none;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.upload-btn::after {
  border: none;
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.btn-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.btn-desc {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.btn-camera {
  background: rgba(77, 166, 255, 0.1);
}

.btn-album {
  background: rgba(77, 166, 255, 0.06);
}

/* ==================== 使用说明卡片 ==================== */
.guide-section {
  width: 100%;
  padding: 24rpx 40rpx;
  flex-shrink: 0;
}

.guide-card {
  padding: 28rpx 32rpx;
}

.guide-header {
  margin-bottom: 20rpx;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4da6ff, #2d5aff);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-text {
  font-size: 26rpx;
  color: var(--color-text);
}

.guide-tip {
  margin-top: 20rpx;
  padding: 16rpx;
  background: rgba(77, 166, 255, 0.06);
  border-radius: var(--radius-sm);
}

.tip-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* ==================== 底部 ==================== */
.footer-section {
  padding: 20rpx 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.footer-text {
  font-size: 20rpx;
  color: rgba(136, 153, 187, 0.5);
}

/* ==================== 加载遮罩 ==================== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-card {
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(77, 166, 255, 0.2);
  border-top-color: #4da6ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.loading-subtext {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 新手引导弹窗内容 ==================== */
.guide-modal-content {
  padding: 10rpx 0;
}

.guide-feature {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(77, 166, 255, 0.1);
}

.guide-feature:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 40rpx;
}

.feature-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.5;
}